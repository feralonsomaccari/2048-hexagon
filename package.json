    "@types/node": "20.19.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "gh-pages": "6.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.3",
