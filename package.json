{
  "name": "2048-hexagon",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "description": "A hexagonal twist on the classic 2048 puzzle game, built with React and TypeScript.",
  "author": "feralonsomaccari",
  "license": "MIT",
  "keywords": [
    "2048",
    "hexagon",
    "hex",
    "puzzle",
    "game",
